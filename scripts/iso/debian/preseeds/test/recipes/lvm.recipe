# Partman expert recipe: GPT + separate /boot, LVM for everything else.
#
# Mount options follow the CIS Debian Linux Benchmark section 1.1
# recommendations. /dev/shm is a tmpfs and cannot be set here -- harden it
# via /etc/fstab (configuration management) after install.
#
# Sizes are fixed (min = priority = max); the LVs total ~140 GiB so vg0 keeps
# free extents for later growth. A disk smaller than that will fail.

unencrypted-lvm ::

    512 512 512 fat32
        $iflabel{ gpt }
        $reusemethod{ }
        method{ efi }
        format{ }
    .

    1024 1024 1024 ext4
        $primary{ }
        $bootable{ }
        method{ format }
        format{ }
        use_filesystem{ }
        filesystem{ ext4 }
        mountpoint{ /boot }
        options/nodev{ nodev }
        options/nosuid{ nosuid }
    .

    1 1 -1 ext4
        $defaultignore{ }
        method{ lvm }
        vg_name{ vg0 }
    .

    32768 32768 32768 ext4
        $lvmok{ }
        in_vg{ vg0 }
        lv_name{ root }
        method{ format }
        format{ }
        use_filesystem{ }
        filesystem{ ext4 }
        mountpoint{ / }
    .

    16384 16384 16384 linux-swap
        $lvmok{ }
        in_vg{ vg0 }
        lv_name{ swap }
        method{ swap }
        format{ }
    .

    40960 40960 40960 ext4
        $lvmok{ }
        in_vg{ vg0 }
        lv_name{ var }
        method{ format }
        format{ }
        use_filesystem{ }
        filesystem{ ext4 }
        mountpoint{ /var }
        options/nodev{ nodev }
        options/nosuid{ nosuid }
    .

    10240 10240 10240 ext4
        $lvmok{ }
        in_vg{ vg0 }
        lv_name{ varlog }
        method{ format }
        format{ }
        use_filesystem{ }
        filesystem{ ext4 }
        mountpoint{ /var/log }
        options/nodev{ nodev }
        options/nosuid{ nosuid }
        options/noexec{ noexec }
    .

    8192 8192 8192 ext4
        $lvmok{ }
        in_vg{ vg0 }
        lv_name{ audit }
        method{ format }
        format{ }
        use_filesystem{ }
        filesystem{ ext4 }
        mountpoint{ /var/log/audit }
        options/nodev{ nodev }
        options/nosuid{ nosuid }
        options/noexec{ noexec }
    .

    8192 8192 8192 ext4
        $lvmok{ }
        in_vg{ vg0 }
        lv_name{ tmp }
        method{ format }
        format{ }
        use_filesystem{ }
        filesystem{ ext4 }
        mountpoint{ /tmp }
        options/nodev{ nodev }
        options/nosuid{ nosuid }
        options/noexec{ noexec }
    .

    8192 8192 8192 ext4
        $lvmok{ }
        in_vg{ vg0 }
        lv_name{ vartmp }
        method{ format }
        format{ }
        use_filesystem{ }
        filesystem{ ext4 }
        mountpoint{ /var/tmp }
        options/nodev{ nodev }
        options/nosuid{ nosuid }
        options/noexec{ noexec }
    .

    10240 10240 10240 ext4
        $lvmok{ }
        in_vg{ vg0 }
        lv_name{ home }
        method{ format }
        format{ }
        use_filesystem{ }
        filesystem{ ext4 }
        mountpoint{ /home }
        options/nodev{ nodev }
        options/nosuid{ nosuid }
    .

    10240 10240 10240 ext4
        $lvmok{ }
        in_vg{ vg0 }
        lv_name{ opt }
        method{ format }
        format{ }
        use_filesystem{ }
        filesystem{ ext4 }
        mountpoint{ /opt }
    .
